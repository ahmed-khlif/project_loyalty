    "joi": "18.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/express": "5.0.5",
    "@nestjs/testing": "12.1.0",
    "eslint": "9.39.5",
    "supertest": "7.1.4",
    "@types/supertest": "6.0.3",
    "tsx": "4.20.6",
